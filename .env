# --- Postgres ---
POSTGRES_DB=trendly
POSTGRES_USER=trendly
POSTGRES_PASSWORD=trendly_dev_password
POSTGRES_PORT=55432

# --- Backend ---
BACKEND_PORT=8080
# Dev-only placeholder. Never use this value outside local development.
JWT_SECRET=dev-only-change-me-please-do-not-use-in-prod

# --- Frontend ---
FRONTEND_PORT=3000
# Build-time var (not runtime): docker-compose.yml passes this to
# frontend/Dockerfile as a Docker build ARG, and Next.js inlines
# NEXT_PUBLIC_* values into the JS bundle at `next build` time. Changing
# this value requires `docker compose up -d --build` (or `docker compose
# build frontend`) to take effect -- a plain `docker compose up` will keep
# using whatever was baked into the already-built image. See
# docs/local-dev.md for the host-dev vs in-network value distinction.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
