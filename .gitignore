# env
# Broad enough to cover every real env-file variant at any depth (bare
# `.env`, `.env.local`, `.env.production`, `.env.development.local`, etc. —
# Next.js in particular loads several of these automatically), while the
# negation keeps every `*.env.example` template committable.
.env*
!*.env.example

# backend
backend/target/
backend/build/
*.class

# frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo

# OS
.DS_Store
